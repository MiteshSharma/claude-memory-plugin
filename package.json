{
  "name": "memory-updater",
  "version": "0.1.0",
  "description": "Persistent memory and context injection plugin for Claude Code",
  "type": "module",
  "bin": {
    "memory-updater": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "plugin/",
    "scripts/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:plugin": "node scripts/build.js",
    "sync": "node scripts/build.js && node scripts/sync.js",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "register": "node scripts/register-hooks.js",
    "register:mcp": "node scripts/register-mcp.js",
    "postinstall": "node scripts/install-plugin.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "memory",
    "context",
    "hooks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.0.0"
}
